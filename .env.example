# Operator Engine reads only canonical OPERATOR_ENGINE_* keys.
# Loopback is the safe default. Use a non-loopback host only behind authenticated ingress.
OPERATOR_ENGINE_HOST=127.0.0.1
OPERATOR_ENGINE_TERMINAL_HOST=127.0.0.1
OPERATOR_ENGINE_PORT=4400
OPERATOR_ENGINE_TERMINAL_PORT=4401
OPERATOR_ENGINE_DISTRIBUTION=stock
OPERATOR_ENGINE_DATA_DIR=.data
OPERATOR_ENGINE_DB_PATH=.data/operator-engine.sqlite
OPERATOR_ENGINE_WORKSPACE_ROOT=.data/workspace
# Optional additional roots. Use ; on Windows and : on macOS/Linux.
# OPERATOR_ENGINE_WORKSPACE_ROOTS=C:/Source;D:/Projects
OPERATOR_ENGINE_TERMINAL_SECRET=replace-with-a-random-32-byte-secret

# Optional Codex executable override. Operator Engine does not install or authenticate it.
# OPERATOR_ENGINE_CODEX_BIN=/absolute/path/to/codex
# Optional OMP executable override for the Theme Seven distribution.
# OPERATOR_ENGINE_OMP_BIN=/absolute/path/to/omp
#
# Optional reviewed Theme Seven T4 endpoint. Only HTTP(S) URLs are accepted.
# OPERATOR_ENGINE_T4_URL=https://example.test
